generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sector {
  id          String       @id @default(cuid())
  code        String       @unique
  nameAr      String
  nameEn      String
  createdAt   DateTime     @default(now())
  departments Department[]
}

model Department {
  id              String                 @id @default(cuid())
  sectorId        String
  sector          Sector                 @relation(fields: [sectorId], references: [id])
  code            String                 @unique
  nameAr          String
  nameEn          String
  sortOrder       Int
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  users           User[]
  assignments     OperationDepartment[]
  needRequests    OperationNeedRequest[]
  customStages    StageDefinition[]      @relation("DepartmentCustomStages")

  @@index([sectorId])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  passwordHash         String
  nameAr               String
  nameEn               String
  role                 String
  tasks                String?
  departmentId         String?
  department           Department?             @relation(fields: [departmentId], references: [id])
  isActive             Boolean                 @default(true)
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?                   @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers         User[]                  @relation("UserDeletedBy")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  operations           Operation[]             @relation("OperationCreator")
  adjustments          FinancialAdjustment[]   @relation("AdjustmentAuthor")
  dateChanges          StageDateChange[]       @relation("DateChangeAuthor")
  audits               AuditLog[]              @relation("AuditActor")
  deletedTypes         OperationType[]         @relation("OperationTypeDeletedBy")
  fundingTranches      FundingTranche[]        @relation("FundingTrancheAuthor")
  needRequestsCreated  OperationNeedRequest[]  @relation("NeedRequestCreator")
  needRequestsReviewed OperationNeedRequest[]  @relation("NeedRequestReviewer")
  deletedAlerts        Alert[]                 @relation("AlertDeletedBy")
  customStagesCreated  StageDefinition[]       @relation("StageDefinitionCreator")

  @@index([role])
  @@index([departmentId])
  @@index([deletedAt])
}

model OperationType {
  id           String                 @id @default(cuid())
  code         String                 @unique
  nameAr       String
  nameEn       String
  isSystem     Boolean                @default(false)
  isActive     Boolean                @default(true)
  sortOrder    Int
  createdAt    DateTime               @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?                  @relation("OperationTypeDeletedBy", fields: [deletedById], references: [id])
  stages       StageDefinition[]
  operations   Operation[]
  needRequests OperationNeedRequest[]

  @@index([deletedAt])
}

model StageDefinition {
  id              String                    @id @default(cuid())
  operationTypeId String
  operationType   OperationType             @relation(fields: [operationTypeId], references: [id])
  code            String
  nameAr          String
  nameEn          String
  sortOrder       Int
  durationMonths  Int                       @default(0)
  durationDays    Int                       @default(0)
  anchor          String
  isActive        Boolean                   @default(true)
  /// null = system default; set = department-scoped custom stage type
  departmentId    String?
  department      Department?               @relation("DepartmentCustomStages", fields: [departmentId], references: [id])
  createdById     String?
  createdBy       User?                     @relation("StageDefinitionCreator", fields: [createdById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime                  @default(now())
  progress        DepartmentStageProgress[]

  /// System rows: departmentId null. Custom codes use CUSTOM_<slug> unique per type.
  @@unique([operationTypeId, code])
  @@index([departmentId])
  @@index([deletedAt])
}

model Operation {
  id                    String                 @id @default(cuid())
  nameAr                String
  nameEn                String                 @default("")
  operationTypeId       String
  operationType         OperationType          @relation(fields: [operationTypeId], references: [id])
  technicalApprovalDate DateTime
  createdById           String
  createdBy             User                   @relation("OperationCreator", fields: [createdById], references: [id])
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignments           OperationDepartment[]
  linkedNeedRequests    OperationNeedRequest[]

  @@index([isDeleted])
  @@index([operationTypeId])
}

model OperationDepartment {
  id             String                    @id @default(cuid())
  operationId    String
  operation      Operation                 @relation(fields: [operationId], references: [id])
  departmentId   String
  department     Department                @relation(fields: [departmentId], references: [id])
  approvalStart  DateTime?
  approvalEnd    DateTime?
  modifiedStart  DateTime?
  modifiedEnd    DateTime?
  approvedAmount String                    @default("0.00")
  isDeleted      Boolean                   @default(false)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  adjustments    FinancialAdjustment[]
  progress       DepartmentStageProgress[]
  fundingTranches FundingTranche[]

  @@unique([operationId, departmentId])
  @@index([departmentId])
}

model FinancialAdjustment {
  id                    String              @id @default(cuid())
  operationDepartmentId String
  operationDepartment   OperationDepartment @relation(fields: [operationDepartmentId], references: [id])
  deltaAmount           String
  effectiveDate         DateTime
  reason                String?
  createdById           String
  createdBy             User                @relation("AdjustmentAuthor", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())

  @@index([operationDepartmentId])
}

model FundingTranche {
  id                    String              @id @default(cuid())
  operationDepartmentId String
  operationDepartment   OperationDepartment @relation(fields: [operationDepartmentId], references: [id], onDelete: Cascade)
  sequence              Int
  sentAt                DateTime
  amount                String              @default("0.00")
  note                  String?
  createdById           String
  createdBy             User                @relation("FundingTrancheAuthor", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())

  @@unique([operationDepartmentId, sequence])
  @@index([operationDepartmentId])
}

model DepartmentStageProgress {
  id                    String              @id @default(cuid())
  operationDepartmentId String
  operationDepartment   OperationDepartment @relation(fields: [operationDepartmentId], references: [id])
  stageDefinitionId     String
  stageDefinition       StageDefinition     @relation(fields: [stageDefinitionId], references: [id])
  baselineStart         DateTime
  baselineDue           DateTime
  plannedStart          DateTime
  plannedDue            DateTime
  actualStart           DateTime?
  completedAt           DateTime?
  isCurrent             Boolean             @default(false)
  dateChanges           StageDateChange[]
  alerts                Alert[]

  @@unique([operationDepartmentId, stageDefinitionId])
}

model StageDateChange {
  id          String                  @id @default(cuid())
  progressId  String
  progress    DepartmentStageProgress @relation(fields: [progressId], references: [id])
  /// STAGE_ADDED | DATES_SET | DATE_REVISED
  kind        String                  @default("DATE_REVISED")
  field       String                  @default("DUE")
  oldDate     DateTime?
  newDate     DateTime?
  reason      String                  @default("")
  note        String?
  createdById String
  createdBy   User                    @relation("DateChangeAuthor", fields: [createdById], references: [id])
  seenAt      DateTime?
  createdAt   DateTime                @default(now())

  @@index([progressId])
  @@index([seenAt])
  @@index([kind])
}

model Alert {
  id          String                  @id @default(cuid())
  progressId  String
  progress    DepartmentStageProgress @relation(fields: [progressId], references: [id])
  type        String
  audience    String
  isDeleted   Boolean                 @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?                   @relation("AlertDeletedBy", fields: [deletedById], references: [id])
  resolvedAt  DateTime?
  createdAt   DateTime                @default(now())

  @@unique([progressId, type])
  @@index([audience, isDeleted, resolvedAt])
  @@index([deletedAt])
}

model OperationNeedRequest {
  id                   String      @id @default(cuid())
  departmentId         String
  department           Department  @relation(fields: [departmentId], references: [id])
  operationTypeId      String
  operationType        OperationType @relation(fields: [operationTypeId], references: [id])
  title                String
  description          String?
  requirements         String
  requestedSupport     String
  estimatedValue       String?
  desiredStartDate     DateTime?
  expectedDurationDays Int?
  status               String      @default("SUBMITTED")
  createdById          String
  createdBy            User        @relation("NeedRequestCreator", fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  reviewedById         String?
  reviewedBy           User?       @relation("NeedRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  decisionNote         String?
  approvedAmount       String?
  linkedOperationId    String?
  linkedOperation      Operation?  @relation(fields: [linkedOperationId], references: [id])

  @@index([departmentId, status])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String?
  summaryAr  String
  summaryEn  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
