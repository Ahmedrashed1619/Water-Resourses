# PostgreSQL is required (SQLite file DBs do not work on Vercel serverless).
# Free hosted option: https://console.neon.tech → Create project → Connect
#
# Prefer the pooled connection string on Vercel (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random secret for JWT sessions — must also be set in Vercel → Settings → Environment Variables
AUTH_SECRET="replace-with-a-long-random-secret"
